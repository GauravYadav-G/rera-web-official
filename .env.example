# Local PostgreSQL connection; provided by the preview platform.
DATABASE_URL=

# Required for real email delivery. Use a verified Resend sending domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional, public contact details. Leave empty to hide the direct email link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set the verified production origin to enable canonicals, sitemap and absolute OG URLs.
NEXT_PUBLIC_SITE_URL=

# Optional distributed rate limiting. Production otherwise uses PostgreSQL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Optional Cloudflare Turnstile. Set both keys or leave both empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
